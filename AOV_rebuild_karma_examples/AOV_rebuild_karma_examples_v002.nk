 knobChanged "if nuke.GUI:\n    try:\n        import stamps; stamps.wiredKnobChanged()\n    except:\n        pass"
 autolabel "nuke.thisNode().knob(\"title\").value()"
 tile_color 0x1000001
 note_font Verdana
 note_font_size 20
 xpos -7532
 ypos 9234
 hide_input true
 addUserKnob {20 wired_tab l "Wired Stamp"}
